# ══════════════════════════════════════════════════════════════
# CARMA — Environment Variables
# Copy this to .env and fill in the values you need.
# No secret is committed to the repository: every value below is
# either empty or a template that the platform detects as
# "not configured".
# ══════════════════════════════════════════════════════════════

# Django core
# Generate one with:  python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
# If left empty, a random key is generated at every start (sessions do not survive a restart).
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# PostgreSQL — required for the research study.
# With config.settings_sqlite these values are ignored.
DB_NAME=CARMADB
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Redis (Celery + Channels)
REDIS_URL=redis://localhost:6379/0

# Qdrant vector DB
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# LLM Keys — leave OPENAI_API_KEY empty to run without a cloud provider
# (the engine falls back to a local Ollama server, then to the rule-based planner).
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_BASE_URL=https://api.openai.com/v1

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
# Leave empty to sign tokens with SECRET_KEY.
JWT_SIGNING_KEY=

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Security
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Email (for account verification)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:5173
