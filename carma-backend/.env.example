# ══════════════════════════════════════════════════════════════
# CARMA — Environment Variables
# Copy this to .env and fill in the values you need.
# No secret is committed to the repository: every value below is
# either empty or a template that the platform detects as
# "not configured".
# ══════════════════════════════════════════════════════════════

# Django core
# Generate one with:  python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
# If left empty, a random key is generated at every start (sessions do not survive a restart).
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# PostgreSQL — required for the research study.
# With config.settings_sqlite these values are ignored.
DB_NAME=CARMADB
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Redis (Celery + Channels)
REDIS_URL=redis://localhost:6379/0

# Qdrant vector DB
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# LLM Keys.  The configurations default to Claude (claude-opus-5-5), which
# needs ANTHROPIC_API_KEY.  A configuration whose model has no credential
# fails its cases loudly — it never falls back to the rule-based planner.
ANTHROPIC_API_KEY=
# Claude output_config.effort: low | medium | high | xhigh | max
ANTHROPIC_EFFORT=medium
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_BASE_URL=https://api.openai.com/v1
# Groq free tier (openai/gpt-oss-20b, openai/gpt-oss-120b) — console.groq.com
GROQ_API_KEY=

# Study protocol.  The evaluation split runs only once the study is registered:
# the OSF registration URL is required and recorded with every run.
PREREGISTRATION_URL=
# OSF personal access token (osf.io/settings/tokens, scope osf.full_write),
# only needed to create the registration draft through the OSF API.
OSF_TOKEN=

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
# Leave empty to sign tokens with SECRET_KEY.
JWT_SIGNING_KEY=

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Security
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Email (for account verification)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:5173
